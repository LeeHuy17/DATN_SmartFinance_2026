# Đặt tại /opt/finbuddy/.env trên VM (không commit file .env thật)

# Tên miền của VM: Azure Portal > VM > Overview > DNS name
DOMAIN=finbuddy.eastasia.cloudapp.azure.com

# Django
# Tạo key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=finbuddy.eastasia.cloudapp.azure.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://finbuddy.eastasia.cloudapp.azure.com

# PostgreSQL chạy trong container db trên cùng VM (chỉ có hiệu lực ở lần tạo volume đầu tiên)
POSTGRES_DB=smartfinance
POSTGRES_USER=smartfinance
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Gmail SMTP cho quên mật khẩu (để trống thì email chỉ in ra log)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Trợ lý AI qua Groq (để trống thì dùng lời khuyên theo luật)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
