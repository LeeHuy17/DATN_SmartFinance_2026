{
  "expo": {
    "name": "Smart Finance",
    "slug": "smart-finance",
    "scheme": "smartfinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Smart Finance cần camera để chụp hóa đơn và đọc số tiền giúp bạn."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Smart Finance cần truy cập ảnh để bạn chọn ảnh hóa đơn có sẵn."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-static.png",
          "imageWidth": 393,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
