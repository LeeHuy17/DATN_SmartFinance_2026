{
  "expo": {
    "name": "FinBuddy",
    "slug": "finbuddy",
    "scheme": "finbuddy",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.leehuy17.finbuddy",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "FinBuddy cần camera để chụp hóa đơn và đọc số tiền giúp bạn.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FinBuddy cần truy cập ảnh để bạn chọn ảnh hóa đơn có sẵn."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-static.png",
          "imageWidth": 393,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "332797bb-753b-4389-ba7f-d1ec3c6b5837"
      }
    },
    "owner": "leehuy17"
  }
}
