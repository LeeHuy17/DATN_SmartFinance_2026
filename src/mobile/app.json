{
  "expo": {
    "name": "Smart Finance",
    "slug": "smart-finance",
    "scheme": "smartfinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-static.png",
          "imageWidth": 393,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
