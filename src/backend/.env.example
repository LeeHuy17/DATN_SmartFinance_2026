# Sao chép file này thành .env rồi điền giá trị: cp .env.example .env

# Django
# Tạo key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
# Thêm IP LAN của máy chạy backend (ipconfig) để điện thoại gọi được API
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Khi deploy sau HTTPS (Caddy trên VM): domain đầy đủ có https:// và bật proxy header
# DJANGO_CSRF_TRUSTED_ORIGINS=https://finbuddy.eastasia.cloudapp.azure.com
# DJANGO_BEHIND_HTTPS_PROXY=1

# PostgreSQL (chỉ có hiệu lực ở lần tạo volume đầu tiên; đổi sau đó phải docker compose down -v)
POSTGRES_DB=smartfinance
POSTGRES_USER=smartfinance
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Gmail SMTP cho quên mật khẩu (để trống thì email chỉ in ra log)
# EMAIL_HOST_PASSWORD là App Password 16 ký tự: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Tuỳ chọn, mặc định: FinBuddy <EMAIL_HOST_USER>
# DEFAULT_FROM_EMAIL=

# Trợ lý AI qua Groq: lấy key ở https://console.groq.com/keys (để trống thì dùng lời khuyên theo luật)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
